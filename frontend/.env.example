# Base URL of the FastAPI backend (no trailing slash, no /api/v1 suffix).
# Leave empty ("") to use same-origin relative URLs behind a reverse proxy (see nginx.conf).
VITE_API_BASE_URL=http://localhost:8000

# Client-side upload limit in MB. Keep in sync with the backend MAX_UPLOAD_SIZE_MB.
VITE_MAX_UPLOAD_MB=10
