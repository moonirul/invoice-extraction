# ── Application ───────────────────────────────────────────
ENVIRONMENT=development            # development | staging | production
LOG_LEVEL=INFO
# Comma-separated list of allowed browser origins (no trailing slash)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── n8n webhooks (required) ───────────────────────────────
# Use the *Production* URL (/webhook/...) outside of quick tests.
# /webhook-test/... URLs only work while the n8n editor is listening.
N8N_EXTRACT_WEBHOOK_URL=http://localhost:5678/webhook/replace-me-extract
N8N_SAVE_WEBHOOK_URL=http://localhost:5678/webhook/replace-me-save
N8N_LIST_WEBHOOK_URL=http://localhost:5678/webhook/replace-me-list

# Optional shared secret sent to n8n on every call (use Header Auth on the Webhook node)
N8N_AUTH_HEADER_NAME=X-Webhook-Secret
N8N_AUTH_TOKEN=

# ── Timeouts & limits ─────────────────────────────────────
N8N_EXTRACT_TIMEOUT_SECONDS=90
N8N_DEFAULT_TIMEOUT_SECONDS=20
MAX_UPLOAD_SIZE_MB=10
MAX_PDF_PAGES=20
